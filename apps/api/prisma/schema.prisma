generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  CONSULTANT
  ADMINISTRATEUR
}

enum StatutTicket {
  NOUVEAU
  EN_COURS
  EN_ATTENTE_CLIENT
  RESOLU
  CLOTURE
}

enum Priorite {
  BASSE
  MOYENNE
  HAUTE
}

model Utilisateur {
  id            String             @id @default(uuid())
  nom           String
  prenom        String
  email         String             @unique
  motDePasse    String
  role          Role               @default(CLIENT)
  dateCreation  DateTime           @default(now())
  ticketsAssigne Ticket[]          @relation("TicketAssignee")
  ticketsClients Ticket[]          @relation("TicketClient")
  historiques   HistoriqueStatut[]  @relation("HistoriqueAuteur")
}

model TicketModule {
  id          String   @id @default(uuid())
  nom         String
  description String?
  tickets     Ticket[]
}

model Ticket {
  id               String            @id @default(uuid())
  numero           String            @unique
  objet            String
  description      String
  priorite         Priorite          @default(MOYENNE)
  statut           StatutTicket      @default(NOUVEAU)
  dateCreation     DateTime          @default(now())
  dateModification DateTime          @updatedAt
  dateCloture      DateTime?

  moduleId         String
  module           TicketModule      @relation(fields: [moduleId], references: [id])

  clientId         String
  client           Utilisateur       @relation("TicketClient", fields: [clientId], references: [id])

  assigneeId       String?
  assignee         Utilisateur?      @relation("TicketAssignee", fields: [assigneeId], references: [id])

  pieceJointes     PieceJointe[]
  compteRendu      CompteRendu?
  historiques      HistoriqueStatut[]

  @@index([clientId])
  @@index([assigneeId])
  @@index([moduleId])
  @@index([statut])
  @@index([dateCreation])
}

model PieceJointe {
  id          String   @id @default(uuid())
  nomFichier  String
  chemin      String
  type        String
  taille      Int
  dateAjout   DateTime @default(now())

  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model CompteRendu {
  id               String   @id @default(uuid())
  contenu          String
  dateCreation     DateTime @default(now())
  dateModification DateTime @updatedAt

  ticketId         String   @unique
  ticket           Ticket   @relation(fields: [ticketId], references: [id])
}

model HistoriqueStatut {
  id             String       @id @default(uuid())
  ancienStatut   StatutTicket?
  nouveauStatut  StatutTicket
  dateChangement DateTime     @default(now())

  auteurId       String
  auteur         Utilisateur  @relation("HistoriqueAuteur", fields: [auteurId], references: [id])

  ticketId       String
  ticket         Ticket       @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}
