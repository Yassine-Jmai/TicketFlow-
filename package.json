{
  "name": "ticketflow",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@ticketflow/api\" \"npm run dev --workspace=@ticketflow/web\"",
    "dev:api": "npm run dev --workspace=@ticketflow/api",
    "dev:web": "npm run dev --workspace=@ticketflow/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
